{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cocos: build (win32 debug)",
      "type": "shell",
      "command": "${input:cocosCmd}",
      "args": [
        "run",
        "-p",
        "win32",
        "-m",
        "debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "cocosCmd",
      "type": "promptString",
      "description": "Path to cocos command (e.g. cocos or C:\\\\cocos2d-x-3.17\\\\tools\\\\cocos2d-console\\\\bin\\\\cocos.bat)",
      "default": "cocos"
    }
  ]
}