{
  "version": 4,
  "configurations": [
    {
      "name": "Windows",
      "includePath": [
        "${workspaceFolder}/Classes",
        "${workspaceFolder}/cocos2d",
        "${workspaceFolder}/cocos2d/cocos",
        "${workspaceFolder}/cocos2d/external",
        "${workspaceFolder}/cocos2d/cocos/editor-support",
        "${workspaceFolder}/proj.win32"
      ],
      "defines": [
        "COCOS2D_DEBUG=1",
        "WIN32",
        "_WINDOWS",
        "_CRT_SECURE_NO_WARNINGS"
      ],
      "compilerPath": "cl.exe",
      "cStandard": "c11",
      "cppStandard": "c++11",
      "intelliSenseMode": "msvc-x64"
    }
  ]
}